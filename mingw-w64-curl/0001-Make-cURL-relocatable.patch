From 8a61681c3755f9d9b2631d063becb69132d0376d Mon Sep 17 00:00:00 2001
From: Ray Donnelly <mingw.android@gmail.com>
Date: Wed, 22 Feb 2017 11:03:04 +0100
Subject: [PATCH 1/N] Make cURL relocatable

This adds the ability to specify CA_BUNDLE paths that are relative to
the MSYS2 pseudo-root directory.

To make it truly relocatable, we use the path to the *cURL library*
instead of the path to the current .exe to determine the location of the
pseudo-root directory (allowing the .exe file to live completely outside
of the MSYS2 system, e.g. in $HOME/bin). This requires Win32 API
available in Windows XP & 2003 and later, well within the Windows
versions supported by Cygwin (and therefore MSYS2).

We also need to be extra careful to extend that path logic to the
ca-bundle.crt used to validate HTTPS *proxies*, not only HTTPS servers.

Note: This patch relies on the `pathtools.c` and `pathtools.h` files to
be copied from `mingw-w64-pathtools` into `lib/`.

Original-patch-by: Ray Donnelly <mingw.android@gmail.com>
Signed-off-by: Johannes Schindelin <johannes.schindelin@gmx.de>
---
 configure.ac           |  2 ++
 lib/Makefile.inc       |  2 ++
 lib/curl_config.h.in   |  3 +++
 lib/vtls/vtls_config.c | 47 ++++++++++++++++++++++++++++++++++++++++++
 4 files changed, 54 insertions(+)

diff --git a/configure.ac b/configure.ac
index 4c4fac2e2b..308fec9feb 100644
--- a/configure.ac
+++ b/configure.ac
@@ -4085,6 +4085,8 @@ AC_CHECK_HEADERS(
 ]
 )
 
+AC_DEFINE_UNQUOTED(CURL_BINDIR, "${prefix}/bin", [bindir])
+
 dnl Checks for typedefs, structures, and compiler characteristics.
 AC_C_CONST
 AC_TYPE_SIZE_T
diff --git a/lib/Makefile.inc b/lib/Makefile.inc
index c4e26849aa..cf681e7711 100644
--- a/lib/Makefile.inc
+++ b/lib/Makefile.inc
@@ -258,6 +258,7 @@ LIB_CFILES =         \
   netrc.c            \
   openldap.c         \
   parsedate.c        \
+  pathtools.c        \
   peer.c             \
   pingpong.c         \
   pop3.c             \
@@ -391,6 +392,7 @@ LIB_HFILES =         \
   multiif.h          \
   netrc.h            \
   parsedate.h        \
+  pathtools.h        \
   peer.h             \
   pingpong.h         \
   pop3.h             \
diff --git a/lib/curl_config.h.in b/lib/curl_config.h.in
index b486ae3272..0766e96adf 100644
--- a/lib/curl_config.h.in
+++ b/lib/curl_config.h.in
@@ -2,6 +2,9 @@
 
 /* !checksrc! disable COPYRIGHT all */
 
+/* Location of executable */
+#undef CURL_BINDIR
+
 /* Location of default CA bundle */
 #undef CURL_CA_BUNDLE
 
diff --git a/lib/vtls/vtls_config.c b/lib/vtls/vtls_config.c
index 080d513bb5..e61e4d782c 100644
--- a/lib/vtls/vtls_config.c
+++ b/lib/vtls/vtls_config.c
@@ -46,6 +46,9 @@
 #include "vtls/vtls.h"
 #include "vtls/vtls_config.h"
 
+#if defined(__MINGW32__)
+#include "../pathtools.h"
+#endif
 
 #define CLONE_STRING(var)                    \
   do {                                       \
@@ -251,6 +254,15 @@ CURLcode Curl_ssl_easy_config_complete(struct Curl_easy *data,
   struct ssl_config_data *sslc = &data->set.ssl;
 #if defined(CURL_CA_PATH) || defined(CURL_CA_BUNDLE)
   CURLcode result;
+#ifdef __MINGW32__
+    const size_t path_max = PATH_MAX;
+#ifdef CURL_CA_PATH
+    char relocated_ca_path[path_max];
+#endif
+#ifdef CURL_CA_BUNDLE
+    char relocated_bundle[path_max];
+#endif
+#endif /* defined(__MINGW32__) */
 #endif
 
   ssl_easy_config_compl_options(origin, data->state.initial_origin, sslc);
@@ -261,15 +273,41 @@ CURLcode Curl_ssl_easy_config_complete(struct Curl_easy *data,
       sslc->primary.native_ca_store = TRUE;
 #endif
 #ifdef CURL_CA_PATH
+#ifdef __MINGW32__
+    get_dll_path(relocated_ca_path, path_max);
+    strip_n_suffix_folders(relocated_ca_path, 1);
+    strncat(relocated_ca_path, "/", path_max - 1);
+    char *relative = get_relative_path(CURL_BINDIR, CURL_CA_PATH);
+    strncat(relocated_ca_path, relative, path_max - 1);
+    free((void*)relative);
+    simplify_path(relocated_ca_path);
+#endif /* defined(__MINGW32__) */
     if(!sslc->custom_capath && !CURL_EASY_STR(data, STRING_SSL_CAPATH)) {
+#ifdef __MINGW32__
+      result = Curl_setstropt(data, STRING_SSL_CAPATH, relocated_ca_path);
+#else
       result = Curl_setstropt(data, STRING_SSL_CAPATH, CURL_CA_PATH);
+#endif /* defined(__MINGW32__) */
       if(result)
         return result;
     }
 #endif
 #ifdef CURL_CA_BUNDLE
+#ifdef __MINGW32__
+    get_dll_path(relocated_bundle, path_max);
+    strip_n_suffix_folders(relocated_bundle, 1);
+    strncat(relocated_bundle, "/", path_max - 1);
+    char *relative = get_relative_path(CURL_BINDIR, CURL_CA_BUNDLE);
+    strncat(relocated_bundle, relative, path_max - 1);
+    free((void*)relative);
+    simplify_path(relocated_bundle);
+#endif /* defined(__MINGW32__) */
     if(!sslc->custom_cafile && !CURL_EASY_STR(data, STRING_SSL_CAFILE)) {
+#ifdef __MINGW32__
+      result = Curl_setstropt(data, STRING_SSL_CAFILE, relocated_bundle);
+#else
       result = Curl_setstropt(data, STRING_SSL_CAFILE, CURL_CA_BUNDLE);
+#endif /* defined(__MINGW32__) */
       if(result)
         return result;
     }
@@ -324,7 +362,11 @@ CURLcode Curl_ssl_easy_config_complete(struct Curl_easy *data,
 #ifdef CURL_CA_PATH
     if(!sslc->custom_capath &&
        !CURL_EASY_STR(data, STRING_SSL_CAPATH_PROXY)) {
+#ifdef __MINGW32__
+      result = Curl_setstropt(data, STRING_SSL_CAPATH_PROXY, relocated_ca_path);
+#else
       result = Curl_setstropt(data, STRING_SSL_CAPATH_PROXY, CURL_CA_PATH);
+#endif /* defined(__MINGW32__) */
       if(result)
         return result;
     }
@@ -332,7 +374,12 @@ CURLcode Curl_ssl_easy_config_complete(struct Curl_easy *data,
 #ifdef CURL_CA_BUNDLE
     if(!sslc->custom_cafile &&
        !CURL_EASY_STR(data, STRING_SSL_CAFILE_PROXY)) {
+#ifdef __MINGW32__
+      result = Curl_setstropt(data, STRING_SSL_CAFILE_PROXY,
+                              relocated_bundle);
+#else
       result = Curl_setstropt(data, STRING_SSL_CAFILE_PROXY, CURL_CA_BUNDLE);
+#endif /* defined(__MINGW32__) */
       if(result)
         return result;
     }
